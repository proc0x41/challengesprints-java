# Exporte estas variáveis no shell/serviço; o Spring não lê .env automaticamente.
PORT=8080
# ADMIN_KEY precisa ser uma chave longa e aleatória, nunca enviada ao frontend.
ADMIN_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chellengesprints-alpha4.vercel.app
SEED_DEMO=true
# PostgreSQL para nuvem. Não habilite estas linhas sem banco configurado.
# JDBC_DATABASE_URL=jdbc:postgresql://host:5432/soulup
# DB_USER=
# DB_PASSWORD=
